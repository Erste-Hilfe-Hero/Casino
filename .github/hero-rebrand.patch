+  [data-brand="noirva"] .catalog-controls { grid-template-columns: minmax(0,1fr) auto; }
+  [data-brand="noirva"] .catalog-capacity { grid-column: 1 / -1; }
+  [data-brand="noirva"] .status-bar { flex-wrap: wrap; }
+}
+
+/* Gameplay opens with essential actions; extra rules, automation, and telemetry remain one toggle away. */
+[data-brand="noirva"] .simple-interface .game-screen .bot-panel,
+[data-brand="noirva"] .simple-interface .game-screen #botPanel,
+[data-brand="noirva"] .simple-interface .game-screen .details-drawer,
+[data-brand="noirva"] .simple-interface .game-screen .control-rail details,
+[data-brand="noirva"] .simple-interface .game-screen [data-testid^="autoplay-panel"] { display: none; }
+@media (min-width:1101px) {
+  [data-brand="noirva"] .simple-interface .game-layout.three-col { grid-template-columns: 300px minmax(0,1fr); }
+}
+
+/* Group language, account methods, session reminders, and sign-out behind one menu. */
+[data-brand="noirva"] .shell-menu { position: relative; }
+[data-brand="noirva"] .shell-menu > summary { list-style: none; display: grid; place-items: center; }
+[data-brand="noirva"] .shell-menu > summary::-webkit-details-marker { display: none; }
+[data-brand="noirva"] .menu-lines { width: 18px; height: 2px; background: var(--gold); box-shadow: 0 -6px var(--gold),0 6px var(--gold); }
+[data-brand="noirva"] .shell-menu-content { position: absolute; right: 0; top: 60px; width: min(260px,calc(100vw - 32px)); padding: 16px; display: grid; gap: 12px; background: #151515; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 16px 40px #0008; z-index: 20; }
+[data-brand="noirva"] .shell-menu-content .shell-locale { width: 100%; }
+[data-brand="noirva"] .shell-menu-content .account-popover { position: static; width: 100%; margin-top: 10px; }
+[data-brand="noirva"] .shell-menu-content [hidden] { display: none; }
+
+/* Secondary help belongs in the menu, so it never covers a game or its primary action. */
+[data-brand="noirva"] .shell-menu-content .report-problem-fab { position: static; width: 100%; min-height: 44px; margin: 0; }
+[data-brand="noirva"] .game-card-content { min-height: 114px; display: flex; flex-direction: column; justify-content: flex-end; }
+[data-brand="noirva"] .game-card .play-button { width: 100%; min-height: 48px; font-size: 18px; margin-top: auto; }
+@media (max-width:700px) {
+  [data-brand="noirva"] .wallet-pill { min-width: 184px; width: auto; }
+  [data-brand="noirva"] .wallet-label { max-width: none; overflow: visible; white-space: normal; }
+  [data-brand="noirva"] .status-bar .status-item:first-child { display: inline-flex; font-size: 10px; }
+  [data-brand="noirva"] .status-bar .status-item:last-child { font-size: 10px; }
+}
