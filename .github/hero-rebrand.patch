+
+/* HERO Midnight Lounge: warm metallic chrome, quiet navy surfaces, and clear red actions.
+   The data-brand hook leaves semantic game colors and Admin styling independent. (UX-007) */
+[data-brand="hero"] .casino-page {
+  background: radial-gradient(ellipse at 12% 0%, #202020 0%, transparent 48%),
+    linear-gradient(160deg, #080808, #0e0e0e 65%, #080808);
+}
+[data-brand="hero"] .casino-page::before {
+  background: radial-gradient(ellipse at 85% 15%, rgba(216,185,121,.08), transparent 40%);
+}
+[data-brand="hero"] .casino-topbar {
+  border-bottom-color: var(--border);
+  box-shadow: 0 8px 32px rgba(0,0,0,.24);
+}
+[data-brand="hero"] .brand-mark {
+  color: var(--gold);
+  font-style: normal;
+  font-family: Georgia, serif;
+  background: linear-gradient(145deg, #202020, #080808);
+  border: 1px solid var(--gold-deep);
+  box-shadow: inset 0 0 0 4px #111111;
+}
+[data-brand="hero"] .brand-copy strong { color: var(--text); letter-spacing: .035em; }
+[data-brand="hero"] .hero-title { font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
+[data-brand="hero"] .hero-rule::before { background: linear-gradient(90deg, transparent, var(--gold-deep)); }
+[data-brand="hero"] .hero-rule::after { background: linear-gradient(90deg, var(--gold-deep), transparent); }
+[data-brand="hero"] .trust-rail,
+[data-brand="hero"] .game-card { border-color: var(--border); background: var(--panel); }
+[data-brand="hero"] .trust-rail { box-shadow: 0 12px 32px rgba(0,0,0,.18); }
+[data-brand="hero"] .game-card::after {
+  background: linear-gradient(180deg, rgba(8,15,25,.06), rgba(8,15,25,.82) 58%, #080808);
+}
+[data-brand="hero"] .card-art:not(.slot-art) { background-color: #131313; }
+[data-brand="hero"] .game-kicker { color: var(--gold); }
+[data-brand="hero"] .play-button,
+[data-brand="hero"] button.gold { color: #080808; background: linear-gradient(135deg, #ead5a5, #c8a563); }
+[data-brand="hero"] .casino-nav button.active,
+[data-brand="hero"] .catalog-category.active { border-color: var(--gold-deep); background: #302b20; color: #f3dfb5; }
+[data-brand="hero"] .wallet-pill { border-color: var(--border); background: #131313; }
+[data-brand="hero"] .auth-entry-header h1 { color: var(--gold); font-family: Georgia, serif; }
+[data-brand="hero"] :focus-visible { outline-color: #ead5a5; }
+
+/* Carry the Lounge palette through catalog controls and persistent chrome, without neon leftovers. */
+[data-brand="hero"] .casino-nav,
+[data-brand="hero"] .catalog-controls,
+[data-brand="hero"] .status-bar,
+[data-brand="hero"] .shell-locale,
+[data-brand="hero"] .icon-button,
+[data-brand="hero"] .round-icon,
+[data-brand="hero"] .catalog-controls input[type="search"] {
+  background: #111111;
+  border-color: var(--border);
+  box-shadow: none;
+}
+[data-brand="hero"] .casino-nav button.active { box-shadow: inset 0 0 0 1px var(--gold-deep); }
+[data-brand="hero"] .catalog-category,
+[data-brand="hero"] .game-kicker,
+[data-brand="hero"] .status-item .gold { border-color: var(--border); background-color: #131313; }
+[data-brand="hero"] .wallet-pill::before { color: #080808; background: var(--gold); box-shadow: none; }
+[data-brand="hero"] .play-button { border-color: var(--gold-deep); box-shadow: none; }
+[data-brand="hero"] .game-card:hover { border-color: var(--gold-deep); }
+[data-brand="hero"] .card-art:not(.slot-art) {
+  background: radial-gradient(ellipse at 65% 15%, #28251e, transparent 75%), #131313;
+}
+/* CSS roulette artwork stays crisp, local, and decorative across every card size. */
+[data-brand="hero"] .roulette-art::before {
+  content: "";
+  position: absolute;
+  width: 78%;
+  aspect-ratio: 1;
+  top: 5%;
+  left: 11%;
+  border: 10px solid #ae8747;
+  border-radius: 50%;
+  background: repeating-conic-gradient(#982b3c 0deg 10deg, #131313 10deg 20deg);
+  box-shadow: 0 0 0 5px #191919, inset 0 0 0 7px #d8b979;
+  transform: rotate(-12deg);
+}
+[data-brand="hero"] .roulette-art::after {
+  content: "";
+  position: absolute;
+  width: 51%;
+  aspect-ratio: 1;
+  top: 15%;
+  left: 24.5%;
+  border: 4px solid #d8b979;
+  border-radius: 50%;
+  background: radial-gradient(circle, #d8b979 0 7%, #131313 8% 16%, #ae8747 17% 19%, #171717 20% 65%, #d8b979 66% 69%, #131313 70%);
+}
+
+/* Original HERO artwork covers every catalog game; no inherited illustration is displayed. (UX-007) */
+[data-brand="hero"] .card-art { background: #080808; }
+[data-brand="hero"] .card-art::before,
+[data-brand="hero"] .card-art::after { display: none; }
+.hero-game-art { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
+[data-brand="hero"] .game-card.featured .hero-game-art { object-fit: contain; }
+[data-brand="hero"] .game-card::after { background: linear-gradient(180deg, transparent, rgba(8,8,8,.7) 55%, #080808); }
+[data-brand="hero"] .report-problem-fab { background: #a92338; }
